          </div>
        </div>
  
        <div className="space-y-4 border-l dark:border-gray-700 pl-4">
          <Input 
              className="w-full text-sm" 
              placeholder="🔍 Filter Encounters..." 
              value={searchTerm} 
              onChange={(e: ChangeEvent<HTMLInputElement>) => setSearchTerm(e.target.value)} 
