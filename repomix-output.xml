        {/* REWARDS */}
        <div className='p-4 bg-yellow-50 dark:bg-yellow-900/10 rounded-xl border border-yellow-100 dark:border-yellow-800'>
          <h3 className='text-xs font-bold uppercase text-yellow-600 mb-2'>
