          </div>
          
          <div className="flex gap-2 pt-2 border-t dark:border-gray-700">
              <button onClick={saveQuestion} className="btn-primary flex-1 bg-black text-white hover:bg-gray-800 dark:bg-white dark:text-black dark:hover:bg-gray-200 py-3 rounded-lg font-bold text-base">
                {editingId ? "Update & Save" : "Create Question"}
              </button>
              {editingId && (
                <button onClick={resetForm} className="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded font-bold hover:bg-gray-300 dark:hover:bg-gray-600 dark:text-white">
                  Cancel
                </button>
              )}
          </div>
        </div>
  
        {/* LIST SIDE */}
        <div className="space-y-3 border-l dark:border-gray-700 pl-4 h-[80vh] flex flex-col">
          {/* Tag fetch & Filter header */}
          <div className="bg-gray-100 dark:bg-gray-700/60 p-3 rounded-xl space-y-2 border border-gray-200 dark:border-gray-600">
            <div className="flex justify-between items-center">
              <h3 className="font-bold text-xs uppercase text-gray-600 dark:text-gray-300 flex items-center gap-1.5">
                <span>🏷️</span>
                <span>Question Filter & Search</span>
              </h3>
              <span className="text-[10px] text-gray-500 dark:text-gray-400 font-mono">
                {visibleQuestions.length} shown of {allQuestions.length} in DB
              </span>
            </div>

            {/* Alphabetical Tag Dropdown */}
            <div>
              <select
                className="input w-full text-xs dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                value={selectedDropdownTag}
                onChange={(e) => {
                  const val = e.target.value;
                  setSelectedDropdownTag(val);
                  setDbTagSearch(val);
                }}
              >
                <option value="">-- All Questions ({allQuestions.length} in Database) --</option>
                {availableTags.map((tag) => (
                  <option key={tag} value={tag}>
                    🏷️ {tag} ({tagCountMap.get(tag) || 0} question{tagCountMap.get(tag) === 1 ? "" : "s"})
                  </option>
                ))}
              </select>
            </div>

            {/* Manual Tag Input with quick clear */}
            <div className="flex gap-2">
              <input
                className="input flex-1 text-xs dark:bg-gray-800 dark:border-gray-600 dark:text-white"
                placeholder="Type tag to filter (or empty for all)..."
                value={dbTagSearch}
                onChange={(e) => {
                  const val = e.target.value;
                  setDbTagSearch(val);
                  const matched = availableTags.find((t) => t.toLowerCase() === val.trim().toLowerCase());
                  setSelectedDropdownTag(matched || "");
                }}
              />
              {dbTagSearch && (
                <button
                  type="button"
                  onClick={() => {
                    setDbTagSearch("");
                    setSelectedDropdownTag("");
                  }}
                  className="bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 px-3 py-1.5 rounded-lg text-xs font-bold shrink-0 transition-colors"
                >
                  Clear Tag
                </button>
              )}
            </div>

            {/* Debounced search filter */}
            <input
              className="input w-full text-xs dark:bg-gray-800 dark:border-gray-600 dark:text-white"
              placeholder={
                (selectedDropdownTag || dbTagSearch).trim()
                  ? `🔍 Search within tag '${selectedDropdownTag || dbTagSearch}'...`
                  : "🔍 Search title, prompt text, LaTeX, or solution..."
              }
              value={localFilter}
              onChange={(e) => setLocalFilter(e.target.value)}
            />

            {/* Active Filters Bar */}
            {(selectedDropdownTag || dbTagSearch || localFilter) && (
              <div className="flex items-center justify-between bg-indigo-50/80 dark:bg-indigo-950/40 px-2.5 py-1.5 rounded-lg border border-indigo-200 dark:border-indigo-900/60 text-xs">
                <div className="flex items-center gap-1.5 flex-wrap text-indigo-900 dark:text-indigo-200">
                  <span className="font-bold text-[10px] uppercase text-indigo-800 dark:text-indigo-300">Active:</span>
                  {(selectedDropdownTag || dbTagSearch) && (
                    <span className="bg-indigo-600 text-white px-2 py-0.5 rounded-full text-[10px] font-bold flex items-center gap-1">
                      <span>🏷️ {selectedDropdownTag || dbTagSearch}</span>
                      <button
                        type="button"
                        onClick={() => {
                          setSelectedDropdownTag("");
                          setDbTagSearch("");
                        }}
                        className="hover:text-red-200 text-xs font-bold ml-0.5"
                        title="Remove tag filter"
                      >
                        ×
                      </button>
                    </span>
                  )}
                  {localFilter && (
                    <span className="bg-purple-600 text-white px-2 py-0.5 rounded-full text-[10px] font-bold flex items-center gap-1">
                      <span>🔍 &ldquo;{localFilter}&rdquo;</span>
                      <button
                        type="button"
                        onClick={() => {
                          setLocalFilter("");
                          setDebouncedFilter("");
                        }}
                        className="hover:text-red-200 text-xs font-bold ml-0.5"
                        title="Clear search text"
                      >
                        ×
                      </button>
                    </span>
                  )}
                </div>
                <button
                  type="button"
                  onClick={loadAllQuestions}
                  className="text-[10px] font-bold text-indigo-700 dark:text-indigo-300 hover:underline shrink-0 ml-2"
                >
                  Clear All
                </button>
              </div>
            )}
          </div>

          {/* BATCH SELECTION & ACTION TOOLBAR */}
          {visibleQuestions.length > 0 && (
            <div className="bg-indigo-50/70 dark:bg-indigo-950/30 p-2.5 rounded-xl border border-indigo-200/80 dark:border-indigo-900/60 space-y-2">
              <div className="flex flex-wrap items-center justify-between gap-2">
                <div className="flex items-center gap-1.5">
                  <button
                    type="button"
                    onClick={selectAllVisible}
                    className="text-[11px] font-bold px-2 py-1 bg-white dark:bg-gray-800 border dark:border-gray-600 rounded text-gray-700 dark:text-gray-200 hover:bg-gray-50"
                  >
                    Select All ({visibleQuestions.length})
                  </button>
                  {selectedQIds.size > 0 && (
                    <button
                      type="button"
                      onClick={deselectAll}
                      className="text-[11px] font-bold px-2 py-1 bg-gray-200 dark:bg-gray-700 rounded text-gray-700 dark:text-gray-200 hover:bg-gray-300"
                    >
                      Deselect
                    </button>
                  )}
                  <span className="text-xs font-black text-indigo-700 dark:text-indigo-300 ml-1">
                    {selectedQIds.size} selected
                  </span>
                </div>

                {/* Batch Scope Selector */}
                <div className="flex items-center gap-1">
                  <span className="text-[10px] font-bold text-gray-600 dark:text-gray-300">
                    {batchAutoDetectLoc ? "Fallback Scope:" : "Scope:"}
                  </span>
                  <select
                    value={batchLocOrder ?? ""}
                    onChange={(e) => setBatchLocOrder(e.target.value ? Number(e.target.value) : null)}
                    className="text-[11px] py-1 px-1.5 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 dark:text-white"
                  >
                    <option value="">Universal (Topics 1–16)</option>
                    {IB_MATH_AA_HL_SYLLABUS.map((t) => (
                      <option key={t.number} value={t.number}>
                        Loc {t.number}: {t.title.slice(0, 18)}...
                      </option>
                    ))}
                  </select>
                </div>
              </div>

              {/* Tag Auto-detection Toggle */}
              <div className="flex items-center justify-between pt-1 border-t border-indigo-200/60 dark:border-indigo-900/40">
                <label className="flex items-center gap-1.5 text-[11px] font-bold text-indigo-900 dark:text-indigo-200 cursor-pointer select-none">
                  <input
                    type="checkbox"
                    checked={batchAutoDetectLoc}
                    onChange={(e) => setBatchAutoDetectLoc(e.target.checked)}
                    className="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5"
                  />
                  <span>Auto-detect Unit per Question from Tags (Recommended)</span>
                </label>
                <span className="text-[10px] text-gray-500 dark:text-gray-400">
                  {batchAutoDetectLoc ? "Strict syllabus bounds per tag" : "Uniform syllabus bounds"}
                </span>
              </div>

              {/* Batch Generate Button */}
              <button
                type="button"
                onClick={startBatchGeneration}
                disabled={selectedQIds.size === 0 || batchRunning}
                className="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold py-2 px-3 rounded-lg text-xs shadow transition-all flex items-center justify-center gap-1.5"
              >
                <span>⚡</span>
                <span>Batch Generate AI Answers for Selected ({selectedQIds.size})</span>
              </button>
              <div className="text-[10px] text-gray-500 dark:text-gray-400 text-center">
                🛡️ Strictly skips questions with existing solutions • Paced at 3.5s per request
              </div>
            </div>
          )}
  
          {/* QUESTIONS SCROLLABLE LIST */}
          <div className="space-y-2 overflow-y-auto pr-2 flex-1 custom-scrollbar">
            {isLoadingQuestions && (
              <div className="py-8 text-center text-xs text-gray-500 dark:text-gray-400 font-bold animate-pulse">
                ⏳ Loading questions database...
              </div>
            )}

            {visibleQuestions.length === 0 && !isLoadingQuestions && (
              <div className="py-12 px-4 text-center text-gray-500 dark:text-gray-400 space-y-2 bg-gray-50/50 dark:bg-gray-800/30 rounded-xl border border-dashed border-gray-300 dark:border-gray-700 my-2">
                <div className="text-3xl">📭</div>
                <div className="font-bold text-sm text-gray-700 dark:text-gray-300">
                  {allQuestions.length === 0 ? "Question Pool is Empty" : "No Questions Match Filter"}
                </div>
                <p className="text-xs max-w-xs mx-auto leading-relaxed">
                  {allQuestions.length === 0
                    ? "Create your first question using the form on the left or the batch importer above."
                    : `No questions match tag '${selectedDropdownTag || dbTagSearch || "none"}' or search '${debouncedFilter}'. Click below to reset.`}
                </p>
                {(selectedDropdownTag || dbTagSearch || debouncedFilter) && (
                  <button
                    type="button"
                    onClick={loadAllQuestions}
                    className="mt-2 px-3 py-1.5 bg-black text-white dark:bg-white dark:text-black rounded-lg text-xs font-bold hover:opacity-80 transition-opacity"
                  >
                    🌐 Clear Filters & Show All ({allQuestions.length})
                  </button>
                )}
              </div>
            )}
            {visibleQuestions.map((q) => {
              const isSelected = q.id ? selectedQIds.has(q.id) : false;
              const hasGm = Boolean(q.solutionText && q.solutionText.trim());
              const hasAi = Boolean(q.aiSolution && q.aiSolution.text && q.aiSolution.text.trim());

              return (
                <div 
                  key={q.id} 
                  onClick={() => loadQuestionToEdit(q)} 
                  className={`p-3 border rounded-lg cursor-pointer transition-all flex items-start gap-2.5 
                          ${editingId === q.id 
                              ? 'bg-blue-50 border-blue-500 ring-2 ring-blue-500 dark:bg-blue-900/30 dark:border-blue-400' 
                              : isSelected
                              ? 'bg-indigo-50/70 border-indigo-400 dark:bg-indigo-950/40 dark:border-indigo-700'
                              : 'dark:border-gray-600 hover:bg-blue-50 dark:hover:bg-blue-900/20'}`
                  }
                >
                  {/* Selection Checkbox */}
                  <input
                    type="checkbox"
                    checked={isSelected}
                    onChange={(e) => {
                      e.stopPropagation();
                      if (q.id) toggleSelectQuestion(q.id);
                    }}
                    className="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer mt-1 shrink-0"
                  />

                  <div className="overflow-hidden flex-1 min-w-0">
                    <div className="font-bold text-sm truncate dark:text-gray-100 flex items-center">
                      {!q.promptContent && <span title="Legacy Question" className="text-yellow-500 mr-2">⚠️</span>}
                      {q.title ? q.title : "Untitled Question"}
                    </div>
                    <div className="text-xs text-gray-500 dark:text-gray-400 truncate mt-1">{getQuestionDisplayText(q)}</div>
                    <div className="text-xs text-gray-400 flex flex-wrap items-center gap-1.5 mt-2">
                      {/* Interactive Tag Badges */}
                      {(q.tags || []).map((t) => (
                        <button
                          key={t}
                          type="button"
                          onClick={(e) => {
                            e.stopPropagation();
                            loadByTag(t);
                          }}
                          className="bg-gray-100 hover:bg-indigo-100 dark:bg-gray-700 dark:hover:bg-indigo-950/60 text-gray-700 dark:text-gray-300 hover:text-indigo-700 dark:hover:text-indigo-300 px-1.5 py-0.5 rounded-full font-mono text-[10px] transition-colors border border-transparent hover:border-indigo-300 dark:hover:border-indigo-700"
                          title={`Click to filter by tag '${t}'`}
                        >
                          #{t}
                        </button>
                      ))}
                      {(!q.tags || q.tags.length === 0) && (
                        <span className="text-[10px] text-gray-400 italic">no tags</span>
                      )}
                      {(() => {
                        const locInfo = getQuestionLocation(q);
                        if (locInfo.isConflict) {
                          return (
                            <span
                              className="bg-red-100 dark:bg-red-950/60 text-red-700 dark:text-red-300 border border-red-300 dark:border-red-800 px-1.5 py-0.2 rounded-full font-bold text-[10px]"
                              title={`Multi-Unit conflict: ${locInfo.conflicts.join(", ")}`}
                            >
                              ⚠️ Loc Conflict
                            </span>
                          );
                        }
                        if (locInfo.locationOrder !== null) {
                          return (
                            <span className="bg-indigo-50 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 px-1.5 py-0.2 rounded-full font-bold text-[10px]">
                              📍 Loc {locInfo.locationOrder}: {locInfo.locationName}
                            </span>
                          );
                        }
                        return (
                          <span className="bg-gray-100 dark:bg-gray-800 text-gray-400 px-1.5 py-0.2 rounded-full text-[10px]">
                            ⚪ Unassigned Loc
                          </span>
                        );
                      })()}
                      <span className="font-bold text-orange-400 text-[10px]">★{q.difficulty}</span>
                      {hasGm && (
                        <span className="bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-300 dark:border-purple-800 px-1.5 py-0.2 rounded-full font-bold text-[10px]">
                          👑 GM Sol
                        </span>
                      )}
                      {!hasGm && hasAi && (
                        <span className="bg-indigo-100 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-300 dark:border-indigo-800 px-1.5 py-0.2 rounded-full font-bold text-[10px]">
                          ⚡ AI Sol
                        </span>
                      )}
                      {!hasGm && !hasAi && (
                        <span className="bg-gray-100 dark:bg-gray-800 text-gray-400 px-1.5 py-0.2 rounded-full font-bold text-[10px]">
                          No Sol
                        </span>
                      )}
                    </div>
                  </div>
                  <button 
                    onClick={(e) => { e.stopPropagation(); if(q.id) deleteQuestion(q.id); }}
                    className="text-red-300 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300 font-bold px-2 py-1"
                  >✕</button>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* ================================================================================== */}
      {/* 🚀 BATCH AI PROGRESS MODAL WITH QUEUE & SAFE RATE-LIMIT PACING */}
      {/* ================================================================================== */}
      {isBatchModalOpen && (
        <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-5">
            {/* Header */}
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2">
                <span className="text-2xl">⚡</span>
                <div>
                  <h3 className="font-bold text-base text-gray-900 dark:text-gray-100">
                    Batch AI Solution Generator
                  </h3>
                  <p className="text-xs text-gray-500 dark:text-gray-400">
                    Queue processing with safe 3.5s delay to protect API limits
                  </p>
                </div>
              </div>
              {!batchRunning && (
                <button
                  type="button"
                  onClick={() => setIsBatchModalOpen(false)}
                  className="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 font-bold text-lg p-1"
                >
                  ✕
                </button>
              )}
            </div>

            {/* Progress Bar */}
            <div className="space-y-1.5">
              <div className="flex justify-between text-xs font-bold text-gray-600 dark:text-gray-300">
                <span>Progress</span>
                <span>
                  {batchStats.processed} / {batchStats.total} (
                  {batchStats.total > 0
                    ? Math.round((batchStats.processed / batchStats.total) * 100)
                    : 0}
                  %)
                </span>
              </div>
              <div className="w-full bg-gray-200 dark:bg-gray-800 rounded-full h-3 overflow-hidden">
                <div
                  className="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 h-full transition-all duration-300"
                  style={{
                    width: `${
                      batchStats.total > 0
                        ? Math.min(100, Math.round((batchStats.processed / batchStats.total) * 100))
                        : 0
                    }%`,
                  }}
                />
              </div>
            </div>

            {/* Live Status Description */}
            <div className="p-3 bg-gray-50 dark:bg-gray-800/60 rounded-xl border border-gray-200 dark:border-gray-700 text-xs space-y-1">
              <div className="flex items-center gap-2 font-semibold text-gray-700 dark:text-gray-300">
                {batchRunning && <span className="animate-spin">🔄</span>}
                <span className="truncate">{batchStats.currentTitle || "Initializing..."}</span>
              </div>
              <div className="text-indigo-600 dark:text-indigo-400 font-mono text-[11px]">
                {batchStats.currentStatus}
              </div>
            </div>

            {/* Stats Grid */}
            <div className="grid grid-cols-4 gap-2 text-center">
              <div className="p-2 rounded-lg bg-gray-100 dark:bg-gray-800">
                <div className="text-[10px] font-bold text-gray-500 uppercase">Selected</div>
                <div className="text-lg font-black text-gray-800 dark:text-gray-200">{batchStats.total}</div>
              </div>
              <div className="p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/60">
                <div className="text-[10px] font-bold text-emerald-600 uppercase">Generated</div>
                <div className="text-lg font-black text-emerald-600">{batchStats.generated}</div>
              </div>
              <div className="p-2 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60">
                <div className="text-[10px] font-bold text-amber-600 uppercase">Skipped</div>
                <div className="text-lg font-black text-amber-600">{batchStats.skipped}</div>
              </div>
              <div className="p-2 rounded-lg bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900/60">
                <div className="text-[10px] font-bold text-red-600 uppercase">Errors</div>
                <div className="text-lg font-black text-red-600">{batchStats.errors}</div>
              </div>
            </div>

            {/* Actions */}
            <div className="flex justify-end gap-2 pt-2 border-t dark:border-gray-800">
              {batchRunning ? (
                <button
                  type="button"
                  onClick={stopBatchGeneration}
                  className="px-4 py-2 bg-red-600 hover:bg-red-500 text-white font-bold text-xs rounded-xl shadow transition-all flex items-center gap-1.5"
                >
                  <span>🛑</span>
                  <span>Stop Queue</span>
                </button>
              ) : (
                <button
                  type="button"
                  onClick={() => setIsBatchModalOpen(false)}
                  className="px-5 py-2 bg-black text-white dark:bg-white dark:text-black font-bold text-xs rounded-xl shadow hover:opacity-80 transition-all"
                >
                  Done
                </button>
              )}
            </div>
          </div>
        </div>
      )}
      </>
    );
}
</file>

<file path="src/app/play/PlayClient.tsx">
'use client';

import { useAuth } from './hooks/useAuth';
import { useGameData } from './hooks/useGameData';
import { useBattle } from './hooks/useBattle';

import { Lobby } from './components/Lobby';
import { BattleIntro } from './components/BattleIntro';
import { BattleScreen } from './components/BattleScreen';
import { VictoryScreen } from './components/VictoryScreen';
import { DefeatScreen } from './components/DefeatScreen';
import { StoryPlayer } from '@/components/StoryPlayer';
import { LoadingScreen } from '@/components/LoadingScreen';

export default function PlayClient() {
  const { user, isLoading: isAuthLoading } = useAuth();
  const {
    character,
    setCharacter,
    encounters,
    gameItems,
    foes,
    subAreas,
    activeStory,
    msg: gameDataMsg,
    setMsg,
    isLoading: isGameDataLoading,
    getFoe,
    getSubArea,
    getLocation,
    completeStory,
  } = useGameData(user);

  const battle = useBattle({
    user,
    character,
    encounters,
    gameItems,
    foes,
    setCharacter,
  });

  if (isAuthLoading || isGameDataLoading || !character) {
    return <LoadingScreen />;
  }

  if (activeStory) {
    return <StoryPlayer story={activeStory} onComplete={completeStory} />;
  }
  
  const currentSubArea = battle.currentEncounter ? getSubArea(battle.currentEncounter.subAreaId) : null;
  const currentLocation = battle.currentEncounter
    ? (currentSubArea ? getLocation(currentSubArea.locationId) : getLocation(battle.currentEncounter.locationId))
    : null;

  switch (battle.mode) {
    case 'intro':
      return (
        <BattleIntro
          encounter={battle.currentEncounter}
          foe={battle.foe}
          questionCount={battle.questions.length}
          onStartBattle={battle.handleStartBattle}
          character={character}
        />
      );
    case 'battle':
      return (
        <BattleScreen
          character={character}
          foe={battle.foe}
          currentQuestion={battle.currentQuestion}
          currentQIndex={battle.currentQIndex}
          totalQuestions={battle.questions.length}
          playerHp={battle.playerHp}
          playerMaxHp={battle.playerMaxHp}
          foeHp={battle.foeHp}
          msg={battle.msg}
          timeLeft={battle.timeLeft}
          totalTime={battle.totalTime}
          isPaused={battle.isPaused}
          isEscaping={battle.isEscaping}
          selectedChoice={battle.selectedChoice}
          gameItems={battle.gameItems}
          inventory={battle.availableInventory}
          showInventory={battle.showInventory}
          setShowInventory={battle.setShowInventory}
          showEscapeConfirm={battle.showEscapeConfirm}
          setShowEscapeConfirm={battle.setShowEscapeConfirm}
          showSubquestionMenu={battle.showSubquestionMenu}
          abandonGroupTurnCost={battle.abandonGroupTurnCost}
          handleAnswer={battle.handleAnswer}
          nextQuestion={battle.nextQuestion}
          continueSubquestion={battle.continueSubquestion}
          abandonGroup={battle.abandonGroup}
          skipQuestion={battle.skipQuestion}
          executeEscape={battle.executeEscape}
          usePotion={battle.usePotion}
          subArea={currentSubArea}
          locationOrder={currentLocation?.order ?? null}
          locationName={currentLocation?.name}
          combatEffect={battle.combatEffect}
          user={user}
          specialFightActive={battle.specialFightActive}
          activeSpecialFightId={battle.activeSpecialFightId}
          isPhase2={battle.isPhase2}
          phase2SpeedPercent={battle.currentEncounter?.phase2TimeSpeedPercent || 25}
          onCompleteSpecialFight={battle.handleSpecialFightComplete}
        />
      );
    case 'win':
      return (
        <VictoryScreen
          character={character}
          levelUpData={battle.levelUpData}
          lootDrops={battle.lootDrops}
          onFightAgain={battle.handleFightAgain}
          onReturnToMap={battle.handleReturnToMap}
          xpReward={battle.xpReward}
          goldReward={battle.goldReward}
          skillGains={battle.skillGains}
        />
      );
    case 'lose':
      return <DefeatScreen msg={battle.msg} onTryAgain={battle.handleFightAgain} onReturnToMap={battle.handleReturnToMap} />;
    default:
      return (
        <Lobby
          encounters={encounters}
          onStartEncounter={battle.handleStartEncounter}
          msg={gameDataMsg || battle.msg}
          encounterWinCounts={character.encounterWins || {}}
          getFoe={getFoe}
        />
      );
  }
}
</file>

<file path="src/app/shop/page.tsx">
"use client";

import { useEffect, useState, Suspense, useMemo } from "react";
import { auth, db } from "@/lib/firebase";
import { onAuthStateChanged, User } from "firebase/auth";
import { 
  doc, getDoc, getDocs, collection, 
  updateDoc, increment, arrayUnion 
} from "firebase/firestore";
import { Character, GameItem, EncounterDoc } from "@/types/game";
import { useRouter, useSearchParams } from "next/navigation";
import { useAudio } from "@/context/AudioContext";
import Link from "next/link";
import { GameIcon } from "@/components/GameIcon";

function ShopContent() {
  const { playTrack } = useAudio()!; 

  useEffect(() => {
    playTrack("/the-minstrels-return-loopable-fantasy-medieval-rpg-music-447849.mp3");
  }, [playTrack]);

  const router = useRouter();
  const searchParams = useSearchParams();
  const encounterId = searchParams.get('encounterId');
  const locationIdParam = searchParams.get('locationId');

  const [user, setUser] = useState<User | null>(null);
  const [character, setCharacter] = useState<Character | null>(null);
  const [items, setItems] = useState<GameItem[]>([]);
  const [encounter, setEncounter] = useState<EncounterDoc | null>(null);
  const [loading, setLoading] = useState(true);
  const [msg, setMsg] = useState("");
  const [selectedItem, setSelectedItem] = useState<GameItem | null>(null);

  const returnMapUrl = locationIdParam 
    ? `/map?locationId=${locationIdParam}`
    : (encounter?.locationId ? `/map?locationId=${encounter.locationId}` : '/map');

  // Load User, Character, Encounter, and Items
  useEffect(() => {
    if (!encounterId) {
      router.replace("/map");
      return;
    }

    const unsub = onAuthStateChanged(auth, async (u) => {
      if (!u) {
        router.push("/login");
        return;
      }
      setUser(u);

      const charRef = doc(db, "characters", u.uid);
      const charSnap = await getDoc(charRef);
      if (charSnap.exists()) {
        setCharacter(charSnap.data() as Character);
      }

      let activeEncounter: EncounterDoc | null = null;
      if (encounterId) {
        try {
          const encSnap = await getDoc(doc(db, "encounters", encounterId));
          if (encSnap.exists()) {
            activeEncounter = { ...encSnap.data(), id: encSnap.id } as EncounterDoc;
            setEncounter(activeEncounter);
          }
        } catch (err) {
          console.error("Error loading encounter:", err);
        }
      }

      const itemsSnap = await getDocs(collection(db, "items"));
      const loadedItems: GameItem[] = [];
      itemsSnap.forEach((d) => {
        const itemData = d.data() as GameItem;
        if (itemData.inShop !== false) {
          loadedItems.push(itemData);
        }
      });

      let finalItems = loadedItems;
      if (activeEncounter && Array.isArray(activeEncounter.shopItemIds) && activeEncounter.shopItemIds.length > 0) {
        const allowedSet = new Set(activeEncounter.shopItemIds);
        finalItems = loadedItems.filter(item => allowedSet.has(item.id));
      }
      setItems(finalItems);
      if (finalItems.length > 0) {
        setSelectedItem(finalItems[0]);
      }

      setLoading(false);
    });
    return () => unsub();
  }, [router, encounterId]);

  // Keep selectedItem valid if items change
  useEffect(() => {
    if (items.length > 0 && (!selectedItem || !items.some(i => i.id === selectedItem.id))) {
      setSelectedItem(items[0]);
    }
  }, [items, selectedItem]);

  // Buy Item Action
  const handleBuy = async (item: GameItem) => {
    if (!user || !character) return;
    if (character.gold < item.price) {
      setMsg("Insufficient gold");
      setTimeout(() => setMsg(""), 2200);
      return;
    }

    setMsg("Purchasing...");
    try {
      const charRef = doc(db, "characters", user.uid);
      const isWeapon = item.slot === "mainHand" || item.slot === "offHand" || item.type === "weapon";
      const newItem = {
        itemId: item.id,
        obtainedAt: Date.now(),
        instanceId: crypto.randomUUID(),
        ...(isWeapon && item.maxDurability ? { 
          durability: item.maxDurability, 
          maxDurability: item.maxDurability 
        } : {})
      };

      await updateDoc(charRef, {
        gold: increment(-item.price),
        inventory: arrayUnion(newItem)
      });

      setCharacter(prev => prev ? ({
        ...prev,
        gold: prev.gold - item.price,
        inventory: [...(prev.inventory || []), newItem]
      }) : null);

      setMsg(`Acquired ${item.name}`);
      setTimeout(() => setMsg(""), 2200);
    } catch (error) {
      console.error(error);
      setMsg("Purchase failed");
      setTimeout(() => setMsg(""), 2200);
    }
  };

  // Stat summary helper: clean, unboxed rows with no rainbow emojis
  const getItemStats = (item: GameItem) => {
    const s = item.stats || {};
    const list: { label: string; value: string }[] = [];

    if (s.a) list.push({ label: 'Stat A (Cubic)', value: `+${s.a}` });
    if (s.b) list.push({ label: 'Stat B (Quad)', value: `+${s.b}` });
    if (s.c) list.push({ label: 'Stat C (Linear)', value: `+${s.c}` });
    if (s.d) list.push({ label: 'Stat D (Flat)', value: `+${s.d}` });
    if (s.xBonus) list.push({ label: 'Variable Bonus', value: `X +${s.xBonus}` });
    if (s.damage?.mult) list.push({ label: 'Damage Bonus', value: `${s.damage.mult > 0 ? '+' : ''}${Math.round(s.damage.mult * 100)}%` });
    if (s.heal?.flat || s.heal?.mult) {
      const val = [s.heal?.flat ? `+${s.heal.flat} HP` : '', s.heal?.mult ? `(+${Math.round(s.heal.mult * 100)}%)` : ''].filter(Boolean).join(' ');
      list.push({ label: 'Health Restoration', value: val });
    }
    if (s.maxHp?.flat || s.maxHp?.mult) {
      const val = [s.maxHp?.flat ? `+${s.maxHp.flat}` : '', s.maxHp?.mult ? `(+${Math.round(s.maxHp.mult * 100)}%)` : ''].filter(Boolean).join(' ');
      list.push({ label: 'Max Health', value: `${val} HP` });
    }
    if (s.time?.flat || s.time?.mult) {
      const val = [s.time?.flat ? `+${s.time.flat}s` : '', s.time?.mult ? `(+${Math.round((s.time.mult > 1 ? s.time.mult - 1 : s.time.mult) * 100)}%)` : ''].filter(Boolean).join(' ');
      list.push({ label: 'Question Timer', value: val });
    }
    if ((item.slot === 'mainHand' || item.slot === 'offHand' || item.type === 'weapon') && item.maxDurability) {
      list.push({ label: 'Durability', value: `${item.maxDurability} uses` });
    }

    return list;
  };

  const selectedItemStats = useMemo(() => {
    return selectedItem ? getItemStats(selectedItem) : [];
  }, [selectedItem]);

  const canAffordSelected = character && selectedItem ? character.gold >= selectedItem.price : false;

  if (loading) {
    return (
      <main className="min-h-screen bg-gray-950 text-white flex items-center justify-center">
        <div className="flex flex-col items-center gap-2">
          <span className="text-3xl animate-pulse">🏪</span>
          <span className="text-xs font-mono uppercase tracking-widest text-gray-400">Opening store...</span>
        </div>
      </main>
    );
  }

  return (
    <main className="relative min-h-screen w-full bg-gray-950 text-gray-100 overflow-x-hidden flex flex-col font-sans select-none">
      
      {/* =========================================================================
          BACKGROUND ART (Crisp & clearly visible with subtle edge scrim)
          ========================================================================= */}
      {encounter?.imageUrl ? (
        <div className="fixed inset-0 pointer-events-none z-0 overflow-hidden">
          <img
            src={encounter.imageUrl}
            alt={encounter.title || "Merchant Outpost"}
            className="w-full h-full object-cover object-center"
          />
          {/* Subtle directional scrim to preserve rich art contrast without muddying colors */}
          <div className="absolute inset-0 bg-gradient-to-tr from-gray-950/85 via-gray-950/40 to-transparent" />
        </div>
      ) : (
        <div className="fixed inset-0 pointer-events-none z-0 bg-gradient-to-b from-gray-900 to-gray-950" />
      )}

      {/* Floating Toast Notification */}
      {msg && (
        <div className="fixed top-20 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-lg bg-gray-900/95 text-amber-300 border border-amber-400/40 shadow-2xl text-xs font-mono font-bold tracking-wide animate-in fade-in duration-200">
          {msg}
        </div>
      )}

      {/* =========================================================================
          TOP BAR: Return Link, Store Name & Purse
          ========================================================================= */}
      <header className="relative z-20 flex items-center justify-between gap-4 px-4 sm:px-6 py-3 bg-gray-950/70 backdrop-blur-md border-b border-white/10 shrink-0">
        
        {/* Left: Return Link & Store Title */}
        <div className="flex items-center gap-3 min-w-0">
          <Link
            href={returnMapUrl}
            className="px-2.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white text-xs font-medium border border-white/10 transition-colors flex items-center gap-1 shrink-0"
          >
            <span>‹</span> Return to Location
          </Link>
          <div className="flex items-center gap-2 min-w-0">
            <GameIcon name="shop" fallback={encounter?.emoji || "🏪"} size="md" />
            <h1 className="text-sm sm:text-base font-black tracking-tight text-white truncate">
              {encounter?.title || "Outpost Merchant"}
            </h1>
            <span className="text-gray-500 hidden sm:inline">·</span>
            <span className="text-xs text-gray-400 font-mono hidden sm:inline">
              {encounter?.shopGreeting || "Curated Expedition Wares"}
            </span>
          </div>
        </div>

        {/* Right: Gold Purse & Character Link */}
        <div className="flex items-center gap-3 shrink-0">
          <div className="px-3 py-1 rounded-lg bg-black/60 border border-amber-400/30 text-amber-300 font-mono text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-sm">
            <GameIcon name="gold" fallback="🪙" size="sm" />
            <span>{character?.gold ?? 0}</span>
            <span className="text-[10px] text-amber-400/70 font-sans uppercase">Gold</span>
          </div>
          <Link
            href="/character"
            className="px-2.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white text-xs font-medium border border-white/10 transition-colors flex items-center gap-1.5"
          >
            <GameIcon name="character" fallback="🦉" size="xs" /> Character
          </Link>
        </div>
      </header>

      {/* Empty Store State */}
      {items.length === 0 && (
        <div className="relative z-10 flex-1 flex flex-col items-center justify-center p-8 text-center">
          <p className="text-sm font-medium text-gray-400">The merchant currently has no wares in stock.</p>
          <Link href={returnMapUrl} className="mt-4 px-4 py-2 rounded-lg bg-white/10 hover:bg-white/15 text-xs font-bold text-white">
            ‹ Return to Location
          </Link>
        </div>
      )}

      {/* =========================================================================
          COMPACT GRID STORE (Option 3)
          Tight, space-efficient item slots on the left, full inspector card on the right.
          Atmospheric background art remains visible around the interface.
          ========================================================================= */}
      {items.length > 0 && (
        <div className="relative z-10 flex-1 flex flex-col md:flex-row p-4 sm:p-6 gap-6 max-w-6xl mx-auto w-full items-center justify-center">
          
          {/* Left: Compact Slots Grid Frame */}
          <div className="w-full md:w-[480px] bg-gray-950/85 backdrop-blur-md rounded-2xl border border-white/10 p-4 shadow-2xl flex flex-col">
            <div className="flex items-center justify-between pb-3 border-b border-white/10 text-xs font-mono text-gray-400 uppercase">
              <span>Merchant Wares</span>
              <span>{items.length} item(s)</span>
            </div>
            
            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-3 max-h-[420px] overflow-y-auto custom-scrollbar pr-1">
              {items.map((item) => {
                const isSelected = selectedItem?.id === item.id;
                const canAfford = (character?.gold || 0) >= item.price;
                return (
                  <button
                    key={item.id}
                    onClick={() => setSelectedItem(item)}
                    className={`p-2.5 rounded-xl border text-left transition-all flex flex-col justify-between ${
                      isSelected
                        ? 'bg-amber-400/20 border-amber-400 text-white shadow-inner scale-[1.02]'
                        : 'bg-black/50 border-white/10 text-gray-300 hover:border-white/30 hover:bg-black/70'
                    }`}
                  >
                    <div className="flex items-center justify-between mb-2">
                      <div className="w-8 h-8 rounded-lg bg-black/60 border border-white/10 flex items-center justify-center overflow-hidden shrink-0">
                        {item.imageUrl ? (
                          <img src={item.imageUrl} alt={item.name} className="w-full h-full object-cover" />
                        ) : (
                          <span className="text-base">📦</span>
                        )}
                      </div>
                      <span className={`text-[10px] font-mono font-bold ${canAfford ? 'text-amber-300' : 'text-gray-500'}`}>
                        🪙 {item.price}
                      </span>
                    </div>
                    <p className="text-xs font-bold truncate text-white">{item.name}</p>
                    <p className="text-[10px] text-gray-400 uppercase truncate mt-0.5">{item.type}</p>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Right: Full Lore & Attribute Inspector */}
          {selectedItem && (
            <div className="w-full md:w-[380px] bg-gray-950/90 backdrop-blur-md rounded-2xl border border-amber-400/30 p-5 shadow-2xl flex flex-col justify-between gap-4">
              <div>
                <div className="flex items-center gap-3 pb-3 border-b border-white/10">
                  <div className="w-14 h-14 rounded-xl bg-black/60 border border-white/10 flex items-center justify-center overflow-hidden shrink-0">
                    {selectedItem.imageUrl ? (
                      <img src={selectedItem.imageUrl} alt={selectedItem.name} className="w-full h-full object-cover" />
                    ) : (
                      <span className="text-2xl">📦</span>
                    )}
                  </div>
                  <div className="min-w-0">
                    <h2 className="text-base font-black text-white truncate">{selectedItem.name}</h2>
                    <p className="text-xs text-gray-400 uppercase font-mono mt-0.5">
                      {selectedItem.type} {selectedItem.slot ? `· Slot: ${selectedItem.slot}` : ''}
                    </p>
                    <p className="text-xs font-mono font-bold text-amber-300 mt-1">
                      🪙 {selectedItem.price} Gold
                    </p>
                  </div>
                </div>

                <p className="text-xs text-gray-300 italic leading-relaxed py-3 border-b border-white/10">
                  &ldquo;{selectedItem.description || "A fine crafted item ready for your journey."}&rdquo;
                </p>

                {selectedItemStats.length > 0 && (
                  <div className="space-y-1.5 pt-3">
                    <span className="text-[10px] uppercase font-mono text-gray-400 tracking-wider">Attributes:</span>
                    <div className="grid grid-cols-1 gap-1">
                      {selectedItemStats.map((st, i) => (
                        <div key={i} className="px-2 py-1 rounded bg-black/40 border border-white/10 text-xs flex justify-between">
                          <span className="text-gray-400">{st.label}</span>
                          <span className="font-mono font-bold text-amber-200">{st.value}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <button
                onClick={() => handleBuy(selectedItem)}
                disabled={!canAffordSelected}
                className={`w-full py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 ${
                  canAffordSelected
                    ? 'bg-amber-400 hover:bg-amber-300 text-gray-950 shadow-md active:scale-98'
                    : 'bg-white/5 text-gray-500 border border-white/10 cursor-not-allowed'
                }`}
              >
                <span className="flex items-center gap-1.5"><GameIcon name="gold" fallback="🪙" size="xs" /> {selectedItem.price} G</span>
                <span>{canAffordSelected ? '— Acquire Ware' : '— Not Enough Gold'}</span>
              </button>
            </div>
          )}
        </div>
      )}

    </main>
  );
}

export default function ShopPage() {
  return (
    <Suspense fallback={
      <div className="min-h-screen bg-gray-950 text-white flex items-center justify-center">
        <div className="flex flex-col items-center gap-2">
          <GameIcon name="shop" fallback="🏪" size="2xl" className="animate-pulse" />
          <span className="text-xs font-mono uppercase tracking-widest text-gray-400">Loading Store...</span>
        </div>
      </div>
    }>
      <ShopContent />
    </Suspense>
  );
}
</file>

<file path="src/types/game.ts">
export type ItemType = 'weapon' | 'armor' | 'potion' | 'misc';
export type EquipmentSlot = 'mainHand' | 'offHand' | 'armor' | 'head';

export interface StatModifier {
  flat?: number; // e.g., +5
  mult?: number; // e.g., 1.5 (which means +50%)
}

// The "template" of an item in the shop
export interface GameItem {
  id: string;
  name: string;
  description: string;
  type: ItemType;
  price: number;
  imageUrl?: string;
  stats?: {
    a?: number;
    b?: number;
    c?: number;
    d?: number;
    xBonus?: number;
    damage?: {
        mult?: number;
    };
    heal?: StatModifier;
    maxHp?: StatModifier;
    time?: StatModifier;
  };
  slot?: EquipmentSlot;
  maxDurability?: number;
  inShop?: boolean;
  goldValue?: number; // Consuming/opening grants this amount of gold
}

export interface InventoryItem {
  itemId: string;
  obtainedAt: number;
  instanceId: string;
  durability?: number;
  maxDurability?: number;
  customData?: {
    goldAmount?: number;
    reason?: string;
    title?: string;
  };
}

export interface CharacterStats {
  a: number; // Coefficient for x^3 (Unlocks Lvl 50)
  b: number; // Coefficient for x^2 (Unlocks Lvl 20)
  c: number; // Coefficient for x   (Linear)
  d: number; // Constant term
}

export interface CharacterSkills {
  algebra: number;
  functions: number;
  geometry: number;
  probabilityAndStatistics: number;
  calculus: number;
}

export interface Character {
  ownerUid: string;
  name: string;
  level: number;
  xp: number;
  gold: number;
  maxHp: number;
  hp: number;
  stats: CharacterStats;
  skills: CharacterSkills;
  unspentPoints: number;
  inventory: InventoryItem[];
  equipment: {
    mainHand: string | null;
    offHand: string | null;
    armor: string | null;
    head: string | null;
  };
  createdAt?: any;
  updatedAt?: any;
  completedStoryEvents: string[]; // List of IDs like ["intro_01", "chapter_1_done"]
  storyFlags: string[]; // e.g., ["DEFEATED_GOBLIN_KING"]
  pendingProgressionFlags?: string[];
  unlockedContinents: string[];   // List of IDs like ["cont_1", "cont_2"]
  encounterWins: { [encounterId: string]: number };
  imageUrl?: string;
}

export interface Monster {
  id?: string;
  name: string;
  description?: string;
  emoji?: string;
  attackDamage?: number;
  level?: number;
  maxHp: number;
  hp: number;
}

export interface Question {
  id:string;
  text: string;
  answer: number;
  difficulty: number;
  packId?: string;
  order?: number;
  timeLimit?: number;
}

// A block of content (text, latex, or image)
export interface ContentBlock {
    type: 'text' | 'latex' | 'image';
    value: string;
}

// A single choice in a structured question, containing multiple content blocks
export interface StructuredChoice {
    content: ContentBlock[];
}

export type QuestionDoc = {
  id?: string;
  title?: string;
  
  // New structured content fields
  promptContent?: ContentBlock[]; 
  choicesContent?: StructuredChoice[];

  // --- LEGACY FIELDS (for backward compatibility) ---
  promptType?: "text" | "latex" | "image";
  promptText?: string; 
  promptLatex?: string;
  promptImageUrl?: string;
  choices?: string[]; 

  choiceType?: "text" | "latex";
  correctIndex: number;
  rewardXp?: number;
  rewardGold?: number;
  difficulty?: number;
  tags: string[];
  packId?: string;
  order?: number;
  groupId?: string; // Links questions that belong to the same multi-part exercise
  timeLimit: number;
  imageUrl?: string;
  solutionUrl?: string; // Optional URL to video walkthrough, image solution, or interactive applet
  solutionText?: string; // Optional text / LaTeX explanation of the solution
  aiSolution?: {
    text: string;
    verifiedCorrectIndex?: number;
    isDiscrepancy?: boolean;
    discrepancyNote?: string;
    generatedAt?: number;
    model?: string;
    locationOrder?: number | null;
  };
};

export type FoeDoc = {
  id?: string;
  name: string;
  description?: string;
  emoji?: string;
  maxHp: number;
  attackDamage: number;
  imageUrl?: string;
};

export type GameLocation = {
  id: string;
  name: string;
  description: string;
  order: number; // To sort them (1. Forest, 2. Caves...)
  imageUrl?: string;
  pathColor?: string; // Hex color for the connecting path in aerial map view (e.g. #fbbf24)
  unlockRequirements?: {
    storyFlags?: string[];
    flagLogic?: FlagLogic;
    flagExpression?: string;
    skills?: Partial<CharacterSkills>;
  };
  assignedTags?: string[]; // Curriculum unit tags uniquely mapped to this location
};

export type SubAreaNodeType = 'encounter' | 'boss' | 'puzzle' | 'lore' | 'shop';

export interface FlagLogicGroup {
  id?: string;
  op?: 'AND' | 'OR';
  operator?: 'AND' | 'OR';
  flags: string[];
}

export interface FlagLogic {
  rootOp?: 'AND' | 'OR';
  rootOperator?: 'AND' | 'OR';
  groups: FlagLogicGroup[];
  expressionText?: string;
}


export type SubArea = {
  id: string;
  locationId: string; // Foreign key to the 'locations' collection
  name: string;
  description: string;
  order: number; // To order sub-areas within a location (1, 2, 3...)
  imageUrl?: string;
  x?: number; // 0 to 100 (percentage horizontal position on aerial background)
  y?: number; // 0 to 100 (percentage vertical position on aerial background)
  nodeType?: SubAreaNodeType; // defaults to 'encounter'
  waypoints?: { x: number; y: number }[]; // Path bend points (0-100%) on the segment leading from the previous sub-area to this one
  previousSubAreaIds?: string[]; // IDs of previous sub-areas this node connects from (takes precedence over 'order')
  customEmoji?: string; // Custom emoji or character for the map pin
  pinColor?: string; // Custom color for the sub-area pin (hex code)
  customDescription?: string; // Custom description displayed right under the pin on the location map
  unlockRequirements?: {
    storyFlags?: string[]; // e.g., ["DEFEATED_GOBLIN_KING"]
    flagLogic?: FlagLogic; // (a OR b) AND c structured grouping
    flagExpression?: string; // string expression for boolean flags
    skills?: Partial<CharacterSkills>; // e.g., { algebra: 10 }
  };
};

export type EncounterDoc = {
  id?: string;
  title: string;
  description?: string;
  order?: number;
  subAreaId: string; // Foreign key to the 'subAreas' collection
  locationId: string; // Legacy foreign key
  foeId: string;
  foes?: string[];
  questionTag: string; //legacy
  questionTags?: string[];
  damagePerCorrect?: number;
  winRewardXp?: number;
  winRewardGold?: number;
  winRewardSkills?: Partial<CharacterSkills>;
  timeMultiplier?: number;
  winRewardItems?: string[];
  winRewardStoryFlag?: string; // Story flag to grant on victory
  shuffleQuestions?: boolean;
  imageUrl?: string;
  emoji?: string;
  specialFightId?: string; // Optional ID of registered special fight (e.g. 'loc2_vieta_scales')
  phase2TimeSpeedPercent?: number; // % faster timer in Phase 2 after clearing special fight (default 25)
  // Store encounter fields
