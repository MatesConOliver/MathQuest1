<file path="firestore.rules">
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isGM() {
      return signedIn() && request.auth.token.email == "oliveru1996@gmail.com";
    }

    // --- CHARACTERS ---
    match /characters/{uid} {
      allow read, update: if isOwner(uid) || isGM();
      allow create: if isOwner(uid);
      // Deletion is handled by a server-side function to ensure all related data is cleaned up.
      allow delete: if false; 

      // Progression subcollections
      match /unlockedSubAreas/{subAreaId} {
        allow read, write: if isOwner(uid) || isGM();
      }
    }
    
    // --- ACTIVE ENCOUNTERS ---
    match /activeEncounters/{uid} {
      allow read, create, update: if isOwner(uid) || isGM();
      allow delete: if false;
    }

    // --- GAME CONTENT (Can be read by any signed-in player, but only written by a GM) ---
    match /stories/{storyId} {
      allow read: if signedIn();
  		allow write: if isGM();
    }
    
    match /items/{itemId} {
      allow read: if signedIn();
      allow write: if isGM(); 
    }

    match /foes/{foeId} {
      allow read: if signedIn();
      allow write: if isGM();
    }

    match /encounters/{encounterId} {
      allow read: if signedIn();
      allow write: if isGM();
    }

    match /locations/{locationId} {
        allow read: if signedIn();
        allow write: if isGM();
    }

    // NEW: Sub-areas are readable by players, writable by GMs
    match /subAreas/{subAreaId} {
        allow read: if signedIn();
        allow write: if isGM();
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow write: if isGM();
    }

    // --- SUBMISSIONS ---
    match /submissions/{submissionId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isGM();
      allow update, delete: if false;
    }
  }
}
