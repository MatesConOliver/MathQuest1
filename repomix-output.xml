                                    <span>#{sa.order} {sa.name}</span>
                                  </button>
                                );
                              })}
                            {subAreas.filter(sa => sa.id !== editingSubArea.id).length === 0 && (
                              <span className="text-xs text-gray-400 italic">No other sub-areas available to link.</span>
