                            <label className="block text-xs font-bold text-gray-700 dark:text-gray-300 mb-1">
                              Node Type
                            </label>
                            <select
                              value={editingSubArea.nodeType || 'encounter'}
                              onChange={(e) => handleFormChange('nodeType', e.target.value as SubAreaNodeType)}
